# Set at least ONE AI provider to activate AI actions. Never paste keys into website forms.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional: protect demo APIs when deploying remotely (see README; place behind auth).
# ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8002,http://localhost:8003

# Free local AI alternative: install Ollama + pull a model before enabling.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# For outbound workflow webhooks, explicitly allowlist hostnames:
# AUTOMATION_ALLOWED_WEBHOOK_HOSTS=your-api.example.com
